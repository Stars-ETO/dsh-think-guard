{
  "name": "dsh-think-guard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "description": "Thinking supervisor for the DeepSeek Harness: an independent reviewer model watches the current agent's reasoning and injects corrections.",
  "author": "Wesley.T",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/delivery-inspector.js",
    "lib/pdf-text-worker.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "vendor"
  ],
  "dsh": {
